---
interface Props { title: string }
const { title } = Astro.props;
// oxlint-disable-next-line import/no-unassigned-import
import "@go-tickets/ui/styles.css";
import { ClientRouter } from "astro:transitions";
import { ClerkIsland } from "../components";
---
<!doctype html>
<html lang="ja">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Go Tickets</title>
  </head>
  <body>
    <div class="mx-auto w-full max-w-6xl px-5">
      <header class="flex items-center justify-between border-b border-border py-6">
        <a class="font-bold text-primary no-underline" href="/">Go Tickets</a>
        <nav>
          <a class="text-sm font-medium text-muted-foreground no-underline hover:text-primary" href="/tickets">
            自分のチケット
          </a>
        </nav>
      </header>
      <main class="pt-8 pb-20 md:pt-12">
        <slot />
        <ClerkIsland client:load transition:persist="clerk-auth" />
      </main>
    </div>
  </body>
</html>
