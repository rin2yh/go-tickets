---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Go Tickets</title>
  </head>
  <body>
    <header><a href="/">Go Tickets</a><nav><a href="/tickets">自分のチケット</a></nav></header>
    <main><slot /></main>
  </body>
</html>
