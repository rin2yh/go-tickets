---
import SiteLayout from "../../layouts/site-layout.astro";
import { ClerkIsland, TicketAvailability } from "../../components/clerk-island";
import { getEvents } from "../../data/events";

export function getStaticPaths() {
  return getEvents().map((event) => ({ params: { eventId: String(event.id) }, props: { event } }));
}

const { event } = Astro.props;
---
<SiteLayout title={event.name}>
  <h1>{event.name}</h1>
  <h2>チケット</h2>
  {event.ticket_types.length === 0 ? (
    <p>申込可能なチケットはありません。</p>
  ) : (
    <ul>
      {event.ticket_types.map((ticket) => (
        <li>
          <strong>{ticket.name}</strong>
          <TicketAvailability client:load eventId={event.id} ticketTypeId={ticket.id} />
        </li>
      ))}
    </ul>
  )}
  {event.ticket_types.length > 0 && (
    <ClerkIsland
      client:load
      mode="event"
      eventId={event.id}
      ticketTypes={event.ticket_types.map(({ id, name }) => ({ id, name }))}
    />
  )}
</SiteLayout>
