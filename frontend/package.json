{
  "name": "go-tickets-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build:public": "pnpm --filter @go-tickets/public build",
    "build:admin": "pnpm --filter @go-tickets/admin build",
    "lint": "oxlint .",
    "typecheck": "pnpm --filter @go-tickets/public typecheck && pnpm --filter @go-tickets/admin typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0"
  },
  "packageManager": "pnpm@11.5.1"
}
