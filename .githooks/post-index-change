#!/bin/bash
set -euo pipefail

# Git passes worktree-update and skip-worktree flags. Ordinary `git add` calls
# this hook with `0 0`, so the flags do not gate staged-file checks.

root=$(git rev-parse --show-toplevel)
cd "$root"

staged=$(mktemp)
trap 'rm -f "$staged"' EXIT
git diff --cached --name-only --diff-filter=ACMR -z > "$staged"

declare -a go_packages=()
declare -a go_files=()
declare -a frontend_lint_files=()
declare -a frontend_format_files=()
declare -a check_paths=()
while IFS= read -r -d '' path; do
  case "$path" in
    backend/*.go)
      check_paths+=("$path")
      if [[ -f "$path" ]]; then
        go_files+=("$path")
        dir=$(dirname "$path")
        if [[ "$dir" == backend ]]; then
          package="./"
        else
          package="./${dir#backend/}"
        fi
        package_found=0
        if ((${#go_packages[@]})); then
          for existing_package in "${go_packages[@]}"; do
            if [[ "$existing_package" == "$package" ]]; then
              package_found=1
              break
            fi
          done
        fi
        if ((package_found == 0)); then
          go_packages+=("$package")
        fi
      fi
      ;;
    frontend/*)
      case "$path" in
        *.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx)
          [[ -f "$path" ]] && frontend_lint_files+=("${path#frontend/}")
          ;;
      esac
      case "$path" in
        *.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.astro|*.json|*.css|*.md|*.yaml|*.yml|*.html)
          check_paths+=("$path")
          [[ -f "$path" ]] && frontend_format_files+=("${path#frontend/}")
          ;;
      esac
      ;;
  esac
done < "$staged"

# Package-based tools read the worktree. Refuse to lint when it differs from
# the index, so their result cannot be mistaken for a check of staged content.
if ((${#check_paths[@]})); then
  for path in "${check_paths[@]}"; do
    if ! git diff-files --quiet -- "$path"; then
      echo "Staged file differs from the worktree: $path" >&2
      echo "Restage it or restore the worktree version before checking." >&2
      exit 1
    fi
  done
fi

if ((${#go_files[@]})); then
  for path in "${go_files[@]}"; do
    formatted=$(gofmt -d "$path")
    if [[ -n "$formatted" ]]; then
      printf '%s\n' "$formatted" >&2
      echo "Run gofmt on $path, then stage the result." >&2
      exit 1
    fi
  done
fi

if ((${#go_packages[@]})); then
  (cd backend && mise exec -- golangci-lint run "${go_packages[@]}")
fi

if ((${#frontend_lint_files[@]})); then
  (cd frontend && mise exec -- pnpm exec oxlint "${frontend_lint_files[@]}")
fi
if ((${#frontend_format_files[@]})); then
  (cd frontend && mise exec -- pnpm exec oxfmt --check "${frontend_format_files[@]}")
fi
