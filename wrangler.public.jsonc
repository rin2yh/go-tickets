{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "go-tickets-public",
  "main": "./backend/cmd/public/worker.mjs",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "CLERK_PUBLISHABLE_KEY": "pk_test_cGxlYXNpbmctc3F1aWQtNzE4OS5jbGVyay5hY2NvdW50cy5kZXYk",
    "CLERK_AUTHORIZED_PARTIES": "https://go-tickets-public.gtms.workers.dev"
  },
  "assets": {
    "directory": "./backend/build/public-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "go-tickets",
      "database_id": "5af5f125-7b2b-4f3e-8879-829a0f4e9369",
      "migrations_dir": "backend/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "issues": {
      "enabled": true
    }
  }
}
